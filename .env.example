# ============================================
# HF BARBARIA - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha os valores no ambiente local.
# NUNCA suba o .env com credenciais reais para o GitHub.

# Chave secreta do Flask (usada para sessões e CSRF)
SECRET_KEY=altere-esta-chave-para-um-valor-seguro

# Senha inicial do admin criado automaticamente (usuario: admin)
# EM PRODUÇÃO defina um valor forte. Após o primeiro login,
# troque a senha em /admin/config.
# ADMIN_SENHA_INICIAL=troque-por-senha-forte-aqui

# URL do banco de dados
# Desenvolvimento (SQLite local):
# DATABASE_URL=sqlite:///C:/Users/higor/barbearia_hf/barbearia.db
#
# Produção (PostgreSQL - fornecido pela hospedagem):
# DATABASE_URL=postgresql://usuario:senha@host:5432/barbearia

# Ambiente da aplicação (development | production)
# Em produção no Render use APP_ENV=production (ativa cookies Secure).
# APP_ENV=development

# Porta usada pelo servidor em produção (Render fornece automaticamente)
# PORT=5000

# HOST do servidor em produção
# HOST=0.0.0.0

# Debug (true apenas em desenvolvimento)
# FLASK_DEBUG=false